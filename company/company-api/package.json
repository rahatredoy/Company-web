{
  "name": "company-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Control-plane API for the Multi-Tenant E-Commerce SaaS platform (company side)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env.localhost src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/workers/index.ts",
    "worker:dev": "tsx watch --clear-screen=false --env-file-if-exists=.env.localhost src/workers/index.ts",
    "typecheck": "tsc --noEmit",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "admin:credentials": "tsx scripts/set-admin-credentials.ts",
    "setup": "npm run db:bootstrap && npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.0.2",
    "bullmq": "^6.0.9",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.11",
    "typescript": "5.9.3"
  }
}
